datasource db {
  // Local development defaults to SQLite via DATABASE_URL=file:./dev.db.
  // For production (Supabase / Neon / AWS RDS) change the provider to "postgresql"
  // and point DATABASE_URL at your PostgreSQL connection string.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  name         String
  avatarUrl    String?
  brandVoice   String?      @default("Professional, clear, insightful, and engaging")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  sessions       Session[]
  accounts       Account[]
  posts          Post[]
  templates      Template[]
  aiContents     AIContent[]
  analytics      Analytics[]
  brandDocuments BrandDocument[]
  campaigns      Campaign[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String        @id @default(uuid())
  userId            String
  platform          String        // "INSTAGRAM" | "LINKEDIN" | "TWITTER" | "YOUTUBE" | "FACEBOOK" | "TIKTOK" | "THREADS"
  platformAccountId String
  accountName       String
  accountHandle     String
  profilePicUrl     String?
  followerCount     Int           @default(0)
  status            String        @default("CONNECTED") // "CONNECTED" | "EXPIRED" | "DISCONNECTED"
  accessTokenEnc    String        // AES-256-GCM encrypted
  refreshTokenEnc   String?       // AES-256-GCM encrypted
  tokenExpiresAt    DateTime?
  scopes            String?
  connectedAt       DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  postAccounts      PostAccount[]
  analytics         Analytics[]

  @@unique([userId, platform, platformAccountId])
}

model Post {
  id              String        @id @default(uuid())
  userId          String
  campaignId      String?
  content         String        // Master Content
  platformVariants String?      // JSON object with per-platform custom copy { "INSTAGRAM": "...", "LINKEDIN": "...", "TWITTER": "...", "YOUTUBE": "..." }
  mediaUrls       String        @default("[]") // JSON stringified array of URLs
  mediaType       String        @default("image") // "image" | "video" | "carousel" | "text"
  status          String        @default("DRAFT") // "DRAFT" | "SCHEDULED" | "PUBLISHING" | "PUBLISHED" | "PARTIALLY_PUBLISHED" | "FAILED" | "CANCELLED"
  scheduledAt     DateTime?
  publishedAt     DateTime?
  timezone        String        @default("UTC")
  targetPlatforms String        @default("[]") // JSON stringified array
  failureReason   String?
  qualityScore    Int?          @default(92)
  retryCount      Int           @default(0)
  nextRetryAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign        Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  postAccounts    PostAccount[]
  analytics       Analytics[]
  jobs            Job[]
}

model PostAccount {
  id             String    @id @default(uuid())
  postId         String
  accountId      String
  platform       String
  platformPostId String?
  customContent  String?   // Platform-specific content override
  status         String    @default("PENDING") // "PENDING" | "PUBLISHING" | "PUBLISHED" | "FAILED" | "CANCELLED"
  error          String?
  publishedAt    DateTime?

  post           Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([postId, accountId])
}

model BrandDocument {
  id          String   @id @default(uuid())
  userId      String
  title       String
  docType     String   @default("GUIDELINE") // "GUIDELINE" | "PRODUCT_SPEC" | "FAQ" | "WEBSITE" | "TOP_POST"
  content     String
  summary     String?
  tags        String?  @default("[]") // JSON array
  fileUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Campaign {
  id              String   @id @default(uuid())
  userId          String
  name            String
  objective       String   @default("Product Launch & Growth")
  durationDays    Int      @default(7)
  targetPlatforms String   @default("[]") // JSON array
  sequenceJson    String   // JSON array of scheduled post objects
  status          String   @default("ACTIVE") // "DRAFT" | "ACTIVE" | "COMPLETED"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts           Post[]
}

model Template {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String
  mediaUrls String?  // JSON stringified
  platforms String?  // JSON stringified
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AIContent {
  id                String   @id @default(uuid())
  userId            String
  prompt            String
  platform          String
  tone              String
  generatedContent  String
  suggestedHashtags String   @default("[]") // JSON stringified
  variations        String   @default("[]") // JSON stringified
  qualityScore      Int?     @default(90)
  createdAt         DateTime @default(now())

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Analytics {
  id             String   @id @default(uuid())
  postId         String
  userId         String
  accountId      String?
  platform       String
  impressions    Int      @default(0)
  reach          Int      @default(0)
  likes          Int      @default(0)
  comments       Int      @default(0)
  shares         Int      @default(0)
  clicks         Int      @default(0)
  engagementRate Float    @default(0.0)
  recordedAt     DateTime @default(now())

  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account        Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
}

model Job {
  id            String    @id @default(uuid())
  postId        String
  status        String    @default("PENDING") // "PENDING" | "PROCESSING" | "COMPLETED" | "FAILED" | "CANCELLED"
  scheduledTime DateTime
  attempts      Int       @default(0)
  maxAttempts   Int       @default(3)
  lastError     String?
  lockedAt      DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  post          Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
}
