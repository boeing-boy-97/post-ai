# =================================================================
# PostWave AI — Production Environment Configuration (.env)
# =================================================================

# -----------------------------------------------------------------
# 1. SERVER & APPLICATION URLS
# -----------------------------------------------------------------
NODE_ENV=production
PORT=8000
FRONTEND_URL=http://localhost:8000
API_URL=http://localhost:8000

# -----------------------------------------------------------------
# 2. DATABASE (PostgreSQL / Supabase / Neon / AWS RDS)
# -----------------------------------------------------------------
# For Local SQLite: file:./dev.db
# For PostgreSQL (Supabase/Neon/RDS): postgresql://user:password@host:5432/dbname?schema=public
DATABASE_URL="file:./dev.db"

# -----------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY SECRETS
# -----------------------------------------------------------------
# Generate a strong 32+ character random string for JWT and AES-256 token encryption
JWT_SECRET=super-secret-jwt-key-change-this-in-production-2026
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=super-secure-production-encryption-key-32-chars!!

# -----------------------------------------------------------------
# 4. INSTAGRAM GRAPH API (Meta for Developers - https://developers.facebook.com)
# -----------------------------------------------------------------
# 1. Create a Meta Business App at https://developers.facebook.com
# 2. Add "Instagram Graph API" and "Facebook Login for Business" products
# 3. Set OAuth Redirect URI to: http://localhost:8000/api/auth/instagram/callback
INSTAGRAM_APP_ID=your_meta_app_id_here
INSTAGRAM_APP_SECRET=your_meta_app_secret_here
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/auth/instagram/callback

# -----------------------------------------------------------------
# 5. LINKEDIN API (LinkedIn Developer Portal - https://developer.linkedin.com)
# -----------------------------------------------------------------
# 1. Create an App at https://developer.linkedin.com
# 2. In "Products" tab, request: "Share on LinkedIn" & "Sign In with LinkedIn using OpenID Connect"
# 3. In "Auth" tab, add Authorized Redirect URL: http://localhost:8000/api/auth/linkedin/callback
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/auth/linkedin/callback

# -----------------------------------------------------------------
# 6. AI ENGINE (OpenAI - https://platform.openai.com)
# -----------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_sk_here
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=800

# -----------------------------------------------------------------
# 7. MEDIA STORAGE (Cloudinary - https://cloudinary.com)
# -----------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# -----------------------------------------------------------------
# 8. OBSERVABILITY & LOGGING
# -----------------------------------------------------------------
LOG_LEVEL=info
